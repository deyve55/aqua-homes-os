<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#010A0F">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AQUA COMMAND CENTER"
        android:textColor="#38DFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Send Aqua a message"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_command_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Speak or type. Aqua will show the message in Sentinel."
        android:textColor="#8FB6C1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/widget_command_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="112dp"
        android:padding="16dp"
        android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine"
        android:imeOptions="actionSend"
        android:hint="What do you need Aqua to do?"
        android:textColor="#FFFFFF"
        android:textColorHint="#668792"
        android:textSize="17sp"
        android:background="@drawable/aqua_command_input" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_command_speak"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Speak"
            android:textAllCaps="false"
            android:textColor="#C9F8FF"
            android:textStyle="bold"
            android:background="@drawable/aqua_widget_action" />

        <Button
            android:id="@+id/widget_command_send"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Send to Aqua"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/aqua_command_send" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_command_open"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="Open Sentinel without sending"
        android:textAllCaps="false"
        android:textColor="#86A8B2"
        android:background="@android:color/transparent" />
</LinearLayout>
