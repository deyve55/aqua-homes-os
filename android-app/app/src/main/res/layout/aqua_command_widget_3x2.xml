<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_resize_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aqua_widget_background_3x2"
    android:padding="0dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.82"
        android:contentDescription="Aqua Neural Link three by two extension field"
        android:scaleType="fitXY"
        android:src="@drawable/aqua_widget_neural_paths_wide" />

    <ImageView
        android:id="@+id/widget_neural_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="Owner-approved Aqua Neural Link three by two proportional surface"
        android:scaleType="centerInside"
        android:src="@drawable/aqua_widget_2x2_approved_v073" />

    <ProgressBar
        android:id="@+id/widget_neural_activity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Cyan outbound and gold return three by two neural activity"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/aqua_widget_neural_activity_wide" />

    <include
        layout="@layout/aqua_widget_selected_neural_activity_wide"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Aqua Action rapid fire microphone"
                android:src="@android:color/transparent" />

            <ImageView
                android:id="@+id/widget_video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="File a video with Aqua"
                android:src="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_photo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="File a photo with Aqua"
                android:src="@android:color/transparent" />

            <ImageView
                android:id="@+id/widget_file"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="File with Aqua"
                android:src="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:contentDescription="Open full conversational Aqua"
        android:src="@android:color/transparent" />

    <TextView
        android:id="@+id/widget_filed_today"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="7dp"
        android:background="@drawable/aqua_widget_count_badge"
        android:contentDescription="Items filed today"
        android:gravity="center"
        android:text="0"
        android:textColor="#001014"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:background="@drawable/aqua_widget_status"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#C8FBFF"
        android:textSize="8sp"
        android:visibility="invisible" />

</FrameLayout>
