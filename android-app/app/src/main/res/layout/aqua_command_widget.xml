<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="1dp">

    <ImageView
        android:id="@+id/widget_neural_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Owner-approved Aqua Neuralink four by six living surface"
        android:scaleType="fitXY"
        android:src="@drawable/aqua_widget_4x6_approved_v073" />

    <ImageView
        android:id="@+id/widget_active_path"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Selected Aqua Neuralink circuit"
        android:scaleType="fitXY"
        android:src="@drawable/aqua_widget_jolt_home"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/widget_shimmer_track"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="265dp"
        android:layout_height="3dp"
        android:layout_gravity="center"
        android:contentDescription="Animated Aqua Neuralink firing path"
        android:indeterminate="true"
        android:indeterminateTint="#78F3FF"
        android:indeterminateTintMode="src_in"
        android:rotation="90" />

    <ProgressBar
        android:id="@+id/widget_shimmer"
        style="@android:style/Widget.ProgressBar.Small"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:contentDescription="Animated Aqua Neuralink neuron pulse"
        android:indeterminate="true"
        android:indeterminateTint="#FFFFFF"
        android:indeterminateTintMode="src_in" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="3.35">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.03"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Aqua Action rapid fire"
                android:src="@android:color/transparent" />
            <ImageView
                android:id="@+id/widget_video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="File a video with Aqua"
                android:src="@android:color/transparent" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.28"
            android:contentDescription="Open full conversational Aqua"
            android:src="@android:color/transparent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.04">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_photo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="File a photo with Aqua"
                    android:src="@android:color/transparent" />
                <ImageView
                    android:id="@+id/widget_file"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="File with Aqua"
                    android:src="@android:color/transparent" />
            </LinearLayout>
            <TextView
                android:id="@+id/widget_filed_today"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="7dp"
                android:background="@drawable/aqua_widget_count_badge"
                android:contentDescription="Items filed today"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="0"
                android:textColor="#001014"
                android:textSize="8sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
