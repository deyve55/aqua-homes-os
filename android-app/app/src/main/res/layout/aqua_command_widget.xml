<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aqua_widget_background"
    android:padding="1dp">

    <ImageView
        android:id="@+id/widget_neural_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Aqua Neuralink living neural field"
        android:scaleType="centerCrop"
        android:src="@drawable/aqua_widget_neuralink_v071" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/aqua_widget_neural_scrim"
        android:orientation="vertical"
        android:padding="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.04"
                android:contentDescription="Open Aqua Sentinel OS"
                android:scaleType="centerInside"
                android:src="@android:color/transparent" />

            <LinearLayout
                android:id="@+id/widget_brand"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.96"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:shadowColor="#B8F8FF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="5"
                    android:text="AQUA\nNEURALINK"
                    android:textColor="#F7FDFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/widget_shimmer"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:contentDescription="Animated Aqua Neuralink shimmer"
                        android:indeterminate="true"
                        android:indeterminateTint="#74EEFF"
                        android:indeterminateTintMode="src_in" />

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp">

                        <ImageView
                            android:id="@+id/widget_cabinet"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/aqua_widget_cabinet_button"
                            android:contentDescription="Items filed today"
                            android:padding="7dp"
                            android:src="@drawable/aqua_widget_icon_file" />

                        <TextView
                            android:id="@+id/widget_filed_today"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/aqua_widget_count_badge"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="#001014"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_ask"
                style="@style/AquaWidgetAction"
                android:drawableTop="@drawable/aqua_widget_icon_ask"
                android:text="ASK AQUA" />

            <TextView
                android:id="@+id/widget_video"
                style="@style/AquaWidgetAction"
                android:drawableTop="@drawable/aqua_widget_icon_video"
                android:text="VIDEO" />

            <TextView
                android:id="@+id/widget_photo"
                style="@style/AquaWidgetAction"
                android:drawableTop="@drawable/aqua_widget_icon_photo"
                android:text="PHOTO" />

            <TextView
                android:id="@+id/widget_file"
                style="@style/AquaWidgetAction"
                android:drawableTop="@drawable/aqua_widget_icon_file"
                android:text="FILE" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
