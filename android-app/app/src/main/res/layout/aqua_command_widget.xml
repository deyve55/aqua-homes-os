<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="9dp"
    android:background="@drawable/aqua_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.82"
            android:contentDescription="Open Aqua Sentinel OS"
            android:padding="1dp"
            android:scaleType="centerInside"
            android:src="@mipmap/aqua_sentinel_launcher" />

        <LinearLayout
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.18"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AQUA\nSENTINEL"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="#32DFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="One mind across every Aqua application."
                android:textColor="#B8CCD3"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/aqua_widget_status"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="READY"
                android:textColor="#BFF7FF"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_ask"
            style="@style/AquaWidgetAction"
            android:text="A\nASK" />

        <TextView
            android:id="@+id/widget_file"
            style="@style/AquaWidgetAction"
            android:text="▤\nFILE" />

        <TextView
            android:id="@+id/widget_photo"
            style="@style/AquaWidgetAction"
            android:text="▧\nPHOTO" />

        <TextView
            android:id="@+id/widget_video"
            style="@style/AquaWidgetAction"
            android:text="▶\nVIDEO" />
    </LinearLayout>
</LinearLayout>
