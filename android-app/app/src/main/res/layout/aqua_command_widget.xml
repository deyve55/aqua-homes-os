<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_resize_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aqua_widget_background"
    android:padding="1dp">

    <ImageView
        android:id="@+id/widget_neural_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Owner-approved Aqua Neuralink four by six living surface"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/aqua_widget_4x6_approved_v073" />

    <ProgressBar
        android:id="@+id/widget_neural_activity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Cyan outbound and gold return neural activity"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/aqua_widget_neural_activity_4x6" />

    <include
        layout="@layout/aqua_widget_selected_neural_activity_4x6"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="3.35">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.03"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Aqua Action rapid fire"
                android:src="@android:color/transparent" />
            <ImageView
                android:id="@+id/widget_video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="File a video with Aqua"
                android:src="@android:color/transparent" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.28"
            android:contentDescription="Open full conversational Aqua"
            android:src="@android:color/transparent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.04">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_photo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="File a photo with Aqua"
                    android:src="@android:color/transparent" />
                <ImageView
                    android:id="@+id/widget_file"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="File with Aqua"
                    android:src="@android:color/transparent" />
            </LinearLayout>
            <TextView
                android:id="@+id/widget_filed_today"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="7dp"
                android:background="@drawable/aqua_widget_count_badge"
                android:contentDescription="Items filed today"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="0"
                android:textColor="#001014"
                android:textSize="8sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="30dp"
        android:background="@drawable/aqua_widget_status"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.18"
        android:paddingHorizontal="13dp"
        android:paddingVertical="5dp"
        android:textColor="#C8FBFF"
        android:textSize="8sp"
        android:visibility="invisible" />
</FrameLayout>
