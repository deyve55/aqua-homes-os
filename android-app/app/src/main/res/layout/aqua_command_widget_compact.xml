<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_resize_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aqua_widget_background"
    android:padding="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/widget_neural_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Owner-approved compact Aqua Neuralink living surface"
            android:scaleType="centerCrop"
            android:src="@drawable/aqua_widget_2x2_approved_v073" />

        <ProgressBar
            android:id="@+id/widget_neural_activity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Cyan outbound and gold return neural activity"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/aqua_widget_neural_activity_2x2" />

        <include
            layout="@layout/aqua_widget_selected_neural_activity_2x2"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_action"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Aqua Action rapid fire"
                    android:src="@android:color/transparent" />
                <ImageView
                    android:id="@+id/widget_video"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="File a video with Aqua"
                    android:src="@android:color/transparent" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_photo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Capture a receipt for today's ledger"
                    android:src="@android:color/transparent" />
                <ImageView
                    android:id="@+id/widget_file"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="File with Aqua"
                    android:src="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:contentDescription="Open full conversational Aqua"
            android:src="@android:color/transparent" />

        <TextView
            android:id="@+id/widget_filed_today"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="@drawable/aqua_widget_count_badge"
            android:contentDescription="Items filed today"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="0"
            android:textColor="#001014"
            android:textSize="6sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="21dp"
            android:background="@drawable/aqua_widget_status"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textColor="#C8FBFF"
            android:textSize="6sp"
            android:visibility="invisible" />
    </FrameLayout>
</FrameLayout>
