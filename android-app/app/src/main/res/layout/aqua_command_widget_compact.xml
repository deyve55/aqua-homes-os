<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aqua_widget_background"
    android:padding="1dp">

    <ImageView
        android:id="@+id/widget_neural_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Aqua Neuralink compact living neural field"
        android:scaleType="centerCrop"
        android:src="@drawable/aqua_neuralink_widget_v071" />

    <ImageView
        android:id="@+id/widget_active_path"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Selected compact Aqua Neuralink circuit"
        android:scaleType="centerCrop"
        android:src="@drawable/aqua_widget_jolt_compact_home"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.42"
            android:text="" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="0.58">

            <ProgressBar
                android:id="@+id/widget_shimmer_track"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Animated compact Aqua Neuralink beam"
                android:indeterminate="true"
                android:indeterminateTint="#6DEBFF"
                android:indeterminateTintMode="src_in" />

            <ProgressBar
                android:id="@+id/widget_shimmer"
                style="@android:style/Widget.ProgressBar.Small"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Animated compact Aqua Neuralink shimmer"
                android:indeterminate="true"
                android:indeterminateTint="#D7FAFF"
                android:indeterminateTintMode="src_in" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/aqua_widget_neural_scrim"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.88"
            android:contentDescription="Open Aqua Sentinel OS"
            android:scaleType="centerInside"
            android:src="@android:color/transparent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_ask"
                style="@style/AquaWidgetAction"
                android:contentDescription="Ask Aqua"
                android:drawableTop="@drawable/aqua_widget_icon_ask"
                android:text="ASK" />

            <TextView
                android:id="@+id/widget_video"
                style="@style/AquaWidgetAction"
                android:contentDescription="File a video with Aqua"
                android:drawableTop="@drawable/aqua_widget_icon_video"
                android:text="VIDEO" />

            <TextView
                android:id="@+id/widget_photo"
                style="@style/AquaWidgetAction"
                android:contentDescription="File a photo with Aqua"
                android:drawableTop="@drawable/aqua_widget_icon_photo"
                android:text="PHOTO" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_file"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/aqua_widget_action"
                    android:clickable="true"
                    android:contentDescription="File with Aqua"
                    android:drawablePadding="1dp"
                    android:drawableTop="@drawable/aqua_widget_icon_file"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingHorizontal="1dp"
                    android:paddingVertical="2dp"
                    android:text="FILE"
                    android:textColor="#F3FDFF"
                    android:textSize="7sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_filed_today"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/aqua_widget_count_badge"
                    android:contentDescription="Items filed today"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#001014"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
