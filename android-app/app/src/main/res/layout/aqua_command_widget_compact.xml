<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="1dp">

    <ImageView
        android:id="@+id/widget_neural_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Owner-approved compact Aqua Neuralink living surface"
        android:scaleType="centerCrop"
        android:src="@drawable/aqua_widget_2x2_approved_v073" />

    <ImageView
        android:id="@+id/widget_active_path"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Selected compact Aqua Neuralink circuit"
        android:scaleType="fitXY"
        android:src="@drawable/aqua_widget_jolt_compact_home"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/widget_shimmer_track"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="110dp"
        android:layout_height="3dp"
        android:layout_gravity="center"
        android:contentDescription="Animated compact Aqua Neuralink firing path"
        android:indeterminate="true"
        android:indeterminateTint="#75F2FF"
        android:indeterminateTintMode="src_in" />

    <ProgressBar
        android:id="@+id/widget_shimmer"
        style="@android:style/Widget.ProgressBar.Small"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="center"
        android:contentDescription="Animated compact Aqua Neuralink neuron pulse"
        android:indeterminate="true"
        android:indeterminateTint="#FFFFFF"
        android:indeterminateTintMode="src_in" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Aqua Action rapid fire"
            android:src="@android:color/transparent" />
        <ImageView
            android:id="@+id/widget_video"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="File a video with Aqua"
            android:src="@android:color/transparent" />
        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="File a photo with Aqua"
            android:src="@android:color/transparent" />
        <ImageView
            android:id="@+id/widget_file"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="File with Aqua"
            android:src="@android:color/transparent" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="Open full conversational Aqua"
        android:src="@android:color/transparent" />

    <TextView
        android:id="@+id/widget_filed_today"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:background="@drawable/aqua_widget_count_badge"
        android:contentDescription="Items filed today"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="0"
        android:textColor="#001014"
        android:textSize="7sp"
        android:textStyle="bold" />
</FrameLayout>
