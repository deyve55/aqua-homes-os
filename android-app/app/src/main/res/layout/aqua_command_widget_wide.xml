<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_resize_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aqua_widget_background"
    android:padding="5dp">

    <ImageView
        android:id="@+id/widget_neural_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.48"
        android:contentDescription="Aqua Neuralink wide responsive surface"
        android:scaleType="fitXY"
        android:src="@drawable/aqua_widget_neural_paths_wide" />

    <ProgressBar
        android:id="@+id/widget_neural_activity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Cyan outbound and gold return wide neural activity"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/aqua_widget_neural_activity_wide" />

    <include
        layout="@layout/aqua_widget_selected_neural_activity_wide"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5">

        <FrameLayout android:id="@+id/widget_action" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:layout_weight="1" android:background="@drawable/aqua_widget_action" android:contentDescription="Aqua Action rapid fire">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/aqua_widget_icon_action" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="7dp" android:text="ACTION" android:textColor="#8CEFFD" android:textSize="7sp" />
        </FrameLayout>

        <FrameLayout android:id="@+id/widget_video" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:layout_weight="1" android:background="@drawable/aqua_widget_action" android:contentDescription="File a video with Aqua">
            <ImageView android:layout_width="29dp" android:layout_height="29dp" android:layout_gravity="center" android:src="@drawable/aqua_widget_icon_video" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="7dp" android:text="VIDEO" android:textColor="#8CEFFD" android:textSize="7sp" />
        </FrameLayout>

        <FrameLayout android:id="@+id/widget_logo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/aqua_widget_action" android:contentDescription="Open full conversational Aqua">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:src="@drawable/aqua_widget_icon_ask" />
        </FrameLayout>

        <FrameLayout android:id="@+id/widget_photo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:layout_weight="1" android:background="@drawable/aqua_widget_action" android:contentDescription="Capture a receipt for today's ledger">
            <ImageView android:layout_width="29dp" android:layout_height="29dp" android:layout_gravity="center" android:src="@drawable/aqua_widget_icon_photo" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="7dp" android:text="RECEIPT" android:textColor="#8CEFFD" android:textSize="7sp" />
        </FrameLayout>

        <FrameLayout android:id="@+id/widget_file" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:layout_weight="1" android:background="@drawable/aqua_widget_action" android:contentDescription="File with Aqua">
            <ImageView android:layout_width="29dp" android:layout_height="29dp" android:layout_gravity="center" android:src="@drawable/aqua_widget_icon_file" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="7dp" android:text="FILE" android:textColor="#8CEFFD" android:textSize="7sp" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_filed_today"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="7dp"
        android:background="@drawable/aqua_widget_count_badge"
        android:contentDescription="Items filed today"
        android:gravity="center"
        android:text="0"
        android:textColor="#001014"
        android:textSize="7sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="7dp"
        android:background="@drawable/aqua_widget_status"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#C8FBFF"
        android:textSize="7sp"
        android:visibility="invisible" />
</FrameLayout>
