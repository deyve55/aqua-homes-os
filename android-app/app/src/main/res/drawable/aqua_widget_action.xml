<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#B73ADCF4" android:endColor="#D50A151B" />
            <stroke android:width="2dp" android:color="#F4C978" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#12000508" />
            <stroke android:width="1dp" android:color="#466DEBFF" />
        </shape>
    </item>
</selector>
