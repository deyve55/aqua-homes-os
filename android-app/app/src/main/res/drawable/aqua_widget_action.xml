<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#8D19C7E8" android:endColor="#C2071820" />
            <stroke android:width="2dp" android:color="#E9FDFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#A40B2631" android:endColor="#D8000609" />
            <stroke android:width="1dp" android:color="#69E8FF" />
        </shape>
    </item>
</selector>
