# Server-only. Never place these values in the APK or sentient-os-web.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

AQUA_GATEWAY_HOST=127.0.0.1
AQUA_GATEWAY_PORT=8787
AQUA_SESSION_SECRET=
AQUA_SESSION_TTL_SECONDS=900
AQUA_OWNER_EMAIL=
# Format: scrypt$<salt>$<derived-key-hex>
AQUA_OWNER_PASSWORD_HASH=

# Server-only satellite projection credentials. Each key is scoped to one
# registered capability and an explicit tenant allowlist.
# Example: {"crm":{"key":"replace-with-a-long-secret","tenantIds":["aqua-homes"]}}
AQUA_ADAPTER_CREDENTIALS_JSON={}

# Loopback-only local development. Never enable on an exposed host.
AQUA_DEVELOPMENT_AUTH=0
