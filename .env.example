# Server-only. Never place these values in the APK or sentient-os-web.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_RECEIPT_VISION_MODEL=gpt-5.6
OPENAI_REALTIME_STANDARD_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_FULL_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

AQUA_GATEWAY_HOST=127.0.0.1
AQUA_GATEWAY_PORT=8787
AQUA_SESSION_SECRET=
AQUA_SESSION_TTL_SECONDS=900
AQUA_OWNER_EMAIL=
# Format: scrypt$<salt>$<derived-key-hex>
AQUA_OWNER_PASSWORD_HASH=
AQUA_MAX_BODY_BYTES=7500000
AQUA_RECEIPT_MAX_IMAGE_BYTES=5000000

# Sentinel SDK 1.1 File Cabinet relay. The endpoint is non-secret and pinned to
# the AquaPulse command receiver. Install both tokens with `wrangler secret put`.
AQUA_PULSE_COMMAND_ENDPOINT=https://aqua-pulse.deyve-docarm-5626.chatgpt.site/api/sentinel/v1/commands
SENTINEL_CLIENT_TOKEN=
AQUA_PULSE_SITE_TOKEN=

# Server-only satellite projection credentials. Each key is scoped to one
# registered capability and an explicit tenant allowlist.
# Example: {"crm":{"key":"replace-with-a-long-secret","tenantIds":["aqua-homes"]}}
AQUA_ADAPTER_CREDENTIALS_JSON={}

# Loopback-only local development. Never enable on an exposed host.
AQUA_DEVELOPMENT_AUTH=0

# Cloudflare production binding. Configure all values above with Worker secrets;
# do not add secret values to wrangler.jsonc or GitHub.
